<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MikomiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mikomi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mikomi" />

        <!--
            桌面图标：每个图标样式对应一个 activity-alias，运行时由 AppIconManager
            用 PackageManager.setComponentEnabledSetting 只启用其中一个。
            注意：MainActivity 本身不再声明 LAUNCHER intent-filter，否则切换图标不生效。

            每个 alias 都设置了独立的 taskAffinity：否则切换图标后桌面新图标与
            旧 task 的 affinity 相同，点新图标会复用 baseIntent 指向「已禁用 alias」
            的旧 task，系统会报 Activity class ... does not exist。

            新增图标的步骤：
            1. 添加 mipmap 资源（mipmap-anydpi-v26 自适应图标 + 各 dpi 方形兜底）；
            2. 在下面追加一个 android:enabled="false" 的 alias，icon/roundIcon 指向新资源；
            3. 在 AppIconStyle 中加一项（aliasName 与这里保持一致），并同步设置页预览图。
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:taskAffinity="com.liomix.mikomi.icon.default"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPink"
            android:enabled="false"
            android:exported="true"
            android:taskAffinity="com.liomix.mikomi.icon.pink"
            android:icon="@mipmap/ic_launcher_pink"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherGreen"
            android:enabled="false"
            android:exported="true"
            android:taskAffinity="com.liomix.mikomi.icon.green"
            android:icon="@mipmap/ic_launcher_green"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_green"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
