<?xml version="1.0" encoding="utf-8"?>
<!--
    明文流量策略：**全局放开**。

    这里不再做域名白名单。插件源（.json）是用户自己导入的，它的站点、它的出流地址、
    它页面里嵌的 m3u8 全都是运行期才知道的，写死白名单等于「导入的源有一半直接不可用」，
    而且失败形态是 OkHttp/WebView 抛 IOException，看起来像「规则写错了」，极难排查。

    代价是明确接受的：这个 App 的核心就是消费第三方源，源本身就不保证 HTTPS。
    应用自身的接口（AniList / Bangumi / 次元库）都走 HTTPS，不受这条影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
